[user]
	name = Trevor Trinh
	email = 50549133+trevortrinh@users.noreply.github.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	ff = only
	rebase = true
[push]
	autoSetupRemote = true
[core]
	autocrlf = input

# Machine-specific identity/signing overrides live outside the repo.
[include]
	path = ~/.gitconfig.local
